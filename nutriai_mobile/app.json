{
  "expo": {
    "name": "NutriAI",
    "slug": "nutriai_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#16412A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matchaby.nutriai-mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriAI memakai kamera untuk memindai makanan.",
        "NSPhotoLibraryUsageDescription": "NutriAI memakai galeri untuk memilih foto makanan.",
        "NSMicrophoneUsageDescription": "NutriAI memakai mikrofon untuk perintah suara."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.matchaby.nutriai_mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "03f9bdea-aee7-43dc-b36c-7933500c7c71"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-background-task",
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ]
  }
}
